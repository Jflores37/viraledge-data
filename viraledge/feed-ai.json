[{"id": "2100281177403695607", "text": "🏎️🔥 Tamil Nadu’s Next Big Opportunity!\n\nFollowing @CMOTamilnadu meeting with @AjithKracing at Silverstone, UK, the NITI Aayog Task Force exploring India’s motorsports revival is an exciting development.\n\nAs AI continues to reshape IT and BPO jobs, we must also focus on manufacturing, automobiles and advanced engineering.\n\nImagine a world-class F1 circuit and Motorsport City in Tamil Nadu! 🏁\n\n🏭 Automobile & EV manufacturing\n🔧 Engineering and technical jobs\n🌍 Motorsport tourism\n🚀 Global investments and new opportunities\n\nSilverstone has shown how motorsports can connect with a wider industrial ecosystem.\n\nWhy not build something similar in Tamil Nadu?\n\nThis is more than a racing track. It’s a vision for jobs, industry and the future of our youth.\n\n@TVKVijayHQ @PMOIndia @NITIAayog", "authorName": "Vijay Fans Trends", "authorUsername": "VijayFansTrends", "authorAvatar": "https://pbs.twimg.com/profile_images/2002312334996574208/_GV4kJ1E_normal.jpg", "authorFollowers": 505931, "authorVerified": true, "likeCount": 115, "retweetCount": 48, "replyCount": 0, "quoteCount": 0, "viewCount": 2299, "bookmarkCount": 4, "createdAt": "2026-09-16T17:50:28+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/VijayFansTrends/status/2100281177403695607"}, {"id": "2100277981281235063", "text": "Bingo!\n\nSo glad they are being exposed right now.", "authorName": "C3", "authorUsername": "C_3C_3", "authorAvatar": "https://pbs.twimg.com/profile_images/945294827742224385/2g_sshAu_normal.jpg", "authorFollowers": 345905, "authorVerified": true, "likeCount": 103, "retweetCount": 27, "replyCount": 1, "quoteCount": 0, "viewCount": 2849, "bookmarkCount": 2, "createdAt": "2026-09-16T17:37:46+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/C_3C_3/status/2100277981281235063"}, {"id": "2100277539570647205", "text": "🚨 Breaking: Apple to teach Anthropic and OpenAI how to slow down AI research", "authorName": "Dr. Eli David", "authorUsername": "DrEliDavid", "authorAvatar": "https://pbs.twimg.com/profile_images/1883187249740681216/OYvBZ0Ym_normal.jpg", "authorFollowers": 856464, "authorVerified": true, "likeCount": 101, "retweetCount": 6, "replyCount": 12, "quoteCount": 1, "viewCount": 3924, "bookmarkCount": 2, "createdAt": "2026-09-16T17:36:01+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/DrEliDavid/status/2100277539570647205"}, {"id": "2100277134556356846", "text": "I would recommend only listening to people that have\n\nA) No financial stake in the success of AI\nB) Have a track record of remaining cool headed and not getting angry\n\nFind a non-biased journalist out there, whose only commitment is to learning more and calling balls and strikes.", "authorName": "Joe Weisenthal", "authorUsername": "TheStalwart", "authorAvatar": "https://pbs.twimg.com/profile_images/2066048089908199424/0iHOXOcE_normal.jpg", "authorFollowers": 448840, "authorVerified": true, "likeCount": 113, "retweetCount": 8, "replyCount": 21, "quoteCount": 2, "viewCount": 10576, "bookmarkCount": 8, "createdAt": "2026-09-16T17:34:24+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/TheStalwart/status/2100277134556356846"}, {"id": "2100276144633434150", "text": "Go from inspiration to physical objects with Gemini. \n\nWith Canvas in Gemini, you can code a custom app to design a vase and change its mathematical parameters to visualize it in 3D. Then, export it as an .STL file for 3D printing to watch your ideas take shape.", "authorName": "Google Gemini", "authorUsername": "GeminiApp", "authorAvatar": "https://pbs.twimg.com/profile_images/1940093473564073984/jiafRcO0_normal.png", "authorFollowers": 574458, "authorVerified": true, "likeCount": 183, "retweetCount": 21, "replyCount": 20, "quoteCount": 3, "viewCount": 11923, "bookmarkCount": 50, "createdAt": "2026-09-16T17:30:28+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/GeminiApp/status/2100276144633434150"}, {"id": "2100275811941302356", "text": "Look at Jev hitting 100% accuracy for @vercel", "authorName": "TypeSafe AI", "authorUsername": "typesafeai", "authorAvatar": "https://pbs.twimg.com/profile_images/2098197729520582656/EgCP0OFe_normal.jpg", "authorFollowers": 45673, "authorVerified": false, "likeCount": 189, "retweetCount": 4, "replyCount": 11, "quoteCount": 1, "viewCount": 8013, "bookmarkCount": 12, "createdAt": "2026-09-16T17:29:09+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/typesafeai/status/2100275811941302356"}, {"id": "2100275395350143288", "text": "Israeli military official:\n\nHezbollah is attempting to regain its strength and is bringing missiles and drones in from Iran and its proxies.\n\nThe Lebanese army must dismantle every organization that is not subject to the government.\n\nAl Hadath", "authorName": "Open Source Intel", "authorUsername": "Osint613", "authorAvatar": "https://pbs.twimg.com/profile_images/2094762039746936832/f8vexHZ2_normal.jpg", "authorFollowers": 1733541, "authorVerified": true, "likeCount": 161, "retweetCount": 11, "replyCount": 6, "quoteCount": 0, "viewCount": 19383, "bookmarkCount": 4, "createdAt": "2026-09-16T17:27:30+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/Osint613/status/2100275395350143288"}, {"id": "2100275330980381021", "text": "AI is probably the biggest issue in politics right now, on several dimensions from jobs to geopolitics. And unfortunately AOC's discussion of it here is basically word salad. Hard to beyond the geriatrics making policy, when the younger politicians don't have any clearer ideas.", "authorName": "Joe Weisenthal", "authorUsername": "TheStalwart", "authorAvatar": "https://pbs.twimg.com/profile_images/2066048089908199424/0iHOXOcE_normal.jpg", "authorFollowers": 448840, "authorVerified": true, "likeCount": 103, "retweetCount": 7, "replyCount": 18, "quoteCount": 0, "viewCount": 11639, "bookmarkCount": 9, "createdAt": "2026-09-16T17:27:14+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/TheStalwart/status/2100275330980381021"}, {"id": "2100275089359163441", "text": "Designers, your job is safe from AI. https://t.co/W7eAOnYvQW", "authorName": "Mitchell Hashimoto", "authorUsername": "mitchellh", "authorAvatar": "https://pbs.twimg.com/profile_images/2082830624415698944/bRo7PB2S_normal.jpg", "authorFollowers": 228869, "authorVerified": true, "likeCount": 341, "retweetCount": 6, "replyCount": 28, "quoteCount": 2, "viewCount": 9814, "bookmarkCount": 13, "createdAt": "2026-09-16T17:26:17+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/mitchellh/status/2100275089359163441"}, {"id": "2100273205285982625", "text": "So let me get this straight. Bill Gates wants us to eat bugs and fake meat, but warns us that AI will be dangerous without regulation. \n\nWho does the regulating? Is he warning because he isn’t the one controlling it? \n\nThis is coming from a man who wants to depopulate the world.", "authorName": "Sassafrass84", "authorUsername": "Sassafrass_84", "authorAvatar": "https://pbs.twimg.com/profile_images/2007867686848475136/pe2K9hqR_normal.jpg", "authorFollowers": 642467, "authorVerified": true, "likeCount": 222, "retweetCount": 49, "replyCount": 27, "quoteCount": 1, "viewCount": 2757, "bookmarkCount": 2, "createdAt": "2026-09-16T17:18:47+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/Sassafrass_84/status/2100273205285982625"}, {"id": "2100272869704097819", "text": "Codex voice for road trips:", "authorName": "Greg Brockman", "authorUsername": "gdb", "authorAvatar": "https://pbs.twimg.com/profile_images/1347621377503711233/bHg3ipfD_normal.jpg", "authorFollowers": 1056055, "authorVerified": true, "likeCount": 241, "retweetCount": 8, "replyCount": 30, "quoteCount": 4, "viewCount": 26281, "bookmarkCount": 33, "createdAt": "2026-09-16T17:17:27+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/gdb/status/2100272869704097819"}, {"id": "2100271448254206108", "text": "No dooming. America will be AI DOMINANT!\n\nWhoever wins AI, WINS! 🇺🇸 https://t.co/X1UQOvq1FP", "authorName": "Department of War CTO", "authorUsername": "DoWCTO", "authorAvatar": "https://pbs.twimg.com/profile_images/2065488436862005248/m8aK8uNj_normal.jpg", "authorFollowers": 108262, "authorVerified": true, "likeCount": 1712, "retweetCount": 309, "replyCount": 146, "quoteCount": 38, "viewCount": 25332, "bookmarkCount": 85, "createdAt": "2026-09-16T17:11:49+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/DoWCTO/status/2100271448254206108"}, {"id": "2100271443086922093", "text": "Footage from southeastern Tehran tonight shows an IRGC ballistic missile launcher on the move.\n\n@mhmiranusa https://t.co/SVQUiTTZPM", "authorName": "Open Source Intel", "authorUsername": "Osint613", "authorAvatar": "https://pbs.twimg.com/profile_images/2094762039746936832/f8vexHZ2_normal.jpg", "authorFollowers": 1733541, "authorVerified": true, "likeCount": 269, "retweetCount": 39, "replyCount": 6, "quoteCount": 3, "viewCount": 25715, "bookmarkCount": 17, "createdAt": "2026-09-16T17:11:47+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/Osint613/status/2100271443086922093"}, {"id": "2100270861555228770", "text": "Claude Design, Claude Slides and Claude Docs also work inside Claude Code now.\n\nAsk for a design review deck or a UI mockup and point it at the actual files and RFCs in the repo. Edit it yourself or keep going in the conversation, and share the link when it's ready.", "authorName": "ClaudeDevs", "authorUsername": "ClaudeDevs", "authorAvatar": "https://pbs.twimg.com/profile_images/2044472418815893504/xf14RxM8_normal.png", "authorFollowers": 689124, "authorVerified": true, "likeCount": 718, "retweetCount": 42, "replyCount": 47, "quoteCount": 15, "viewCount": 60689, "bookmarkCount": 200, "createdAt": "2026-09-16T17:09:29+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/ClaudeDevs/status/2100270861555228770"}, {"id": "2100270818433643000", "text": "Claude Code can now make docs and slides as artifacts, so you can share and collaborate with other people on your team.\n\nFor example, ask Claude to make a spec as a doc, share it to your teammates for feedback, and when it's ready ask Claude to implement.", "authorName": "Thariq", "authorUsername": "trq212", "authorAvatar": "https://pbs.twimg.com/profile_images/1976939058741039104/r3GgzqRh_normal.jpg", "authorFollowers": 342707, "authorVerified": true, "likeCount": 226, "retweetCount": 11, "replyCount": 18, "quoteCount": 5, "viewCount": 28016, "bookmarkCount": 57, "createdAt": "2026-09-16T17:09:18+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/trq212/status/2100270818433643000"}, {"id": "2100270740113072566", "text": "JUST IN: 𝕏 adds “Trade” buttons to supported cashtags in the U.S., connecting users to Coinbase, Kraken, Gemini, &amp; other partners.", "authorName": "Polymarket", "authorUsername": "Polymarket", "authorAvatar": "https://pbs.twimg.com/profile_images/2005664281002491904/bz2ZO_nU_normal.jpg", "authorFollowers": 1951051, "authorVerified": true, "likeCount": 228, "retweetCount": 41, "replyCount": 39, "quoteCount": 30, "viewCount": 53548, "bookmarkCount": 14, "createdAt": "2026-09-16T17:09:00+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/Polymarket/status/2100270740113072566"}, {"id": "2100270138352361572", "text": ". @tedlieu trying to slow down American AI development so China takes the lead is very troubling.", "authorName": "Richard Grenell", "authorUsername": "RichardGrenell", "authorAvatar": "https://pbs.twimg.com/profile_images/2060885210536046592/llzbCYVx_normal.jpg", "authorFollowers": 1846562, "authorVerified": true, "likeCount": 798, "retweetCount": 160, "replyCount": 33, "quoteCount": 6, "viewCount": 14123, "bookmarkCount": 5, "createdAt": "2026-09-16T17:06:36+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/RichardGrenell/status/2100270138352361572"}, {"id": "2100269791818740020", "text": "˗ˏˋ ♡ ˎˊ˗ gemini, virgo, sagittarius, pisces (s, m, r,)\n\n— good news coming towards you before september ends! 🌟\n\n• finally getting momentum after feeling like you’ve been doing EVERYTHING yourself\n\n• a new opportunity showing up faster than expected\n\n—", "authorName": "🌛Noah | open readings", "authorUsername": "GreenIrisTarot", "authorAvatar": "https://pbs.twimg.com/profile_images/1671891857612361728/vr6w2L0K_normal.jpg", "authorFollowers": 70029, "authorVerified": true, "likeCount": 241, "retweetCount": 18, "replyCount": 1, "quoteCount": 1, "viewCount": 4676, "bookmarkCount": 128, "createdAt": "2026-09-16T17:05:14+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/GreenIrisTarot/status/2100269791818740020"}, {"id": "2100269758725656846", "text": "New best score on ARC-AGI-3.\n\nNeuraxon just hit 0.38.\n\nNo LLM. No GPUs.\n\nA bio-inspired digital brain running on ordinary processors. https://t.co/Dp8CvKS1S1", "authorName": "Qubic", "authorUsername": "_Qubic_", "authorAvatar": "https://pbs.twimg.com/profile_images/1955219973753720832/mcLoBRaZ_normal.jpg", "authorFollowers": 100111, "authorVerified": true, "likeCount": 111, "retweetCount": 32, "replyCount": 3, "quoteCount": 0, "viewCount": 3369, "bookmarkCount": 0, "createdAt": "2026-09-16T17:05:06+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/_Qubic_/status/2100269758725656846"}, {"id": "2100269586545344535", "text": "It's a tale of two viruses.  One created in 2020 (Wuhan Labs), the other created in 2026 (Frontier Labs).\n\nOne was molecular (covid), the other digital (AI).\n\nBoth man made.\nBoth promoted by media.\nBoth escape a lab.\nBoth create fear/panic.\nBoth require experts to inform.\nBoth introduce mitigation measures.\nBoth end with govt control rules.\n\nBoth timed to coincide w/ critical elections.\n\nCOVID Passport / Digital ID\n\nTrust the medical scientists\nTrust the computer scientists\n\nThere's a pattern here folks.  Stop me when you can see it.", "authorName": "TheLastRefuge", "authorUsername": "TheLastRefuge2", "authorAvatar": "https://pbs.twimg.com/profile_images/2264686404/uq1gubtgx0i78lis0msg_normal.jpeg", "authorFollowers": 331709, "authorVerified": true, "likeCount": 251, "retweetCount": 124, "replyCount": 7, "quoteCount": 61, "viewCount": 5293, "bookmarkCount": 22, "createdAt": "2026-09-16T17:04:25+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/TheLastRefuge2/status/2100269586545344535"}]