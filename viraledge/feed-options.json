[{"id": "2099989209184424277", "text": "So far, the market hasn’t liked what Warsh has had to say at FOMC press conferences.\n\n$SPX on the last two FOMC days:\n• June 17: −1.21%\n• July 29: −1.52%", "authorName": "TT3", "authorUsername": "TradingThomas3", "authorAvatar": "https://pbs.twimg.com/profile_images/1998408705717489664/SeuMn-3C_normal.jpg", "authorFollowers": 138182, "authorVerified": true, "likeCount": 56, "retweetCount": 5, "replyCount": 4, "quoteCount": 0, "viewCount": 4255, "bookmarkCount": 1, "createdAt": "2026-09-15T22:30:18+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/TradingThomas3/status/2099989209184424277"}, {"id": "2099985675789762693", "text": "$SPY just lost three major layers of technical support at once\n\nBrace for tomorrows fed meeting... https://t.co/B2NOYSYW8n", "authorName": "Andrew Aziz", "authorUsername": "BearBullTraders", "authorAvatar": "https://pbs.twimg.com/profile_images/2006452394364907524/kOqsJsSB_normal.jpg", "authorFollowers": 119646, "authorVerified": true, "likeCount": 157, "retweetCount": 16, "replyCount": 15, "quoteCount": 0, "viewCount": 16859, "bookmarkCount": 1, "createdAt": "2026-09-15T22:16:15+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/BearBullTraders/status/2099985675789762693"}, {"id": "2099978292770275777", "text": "Who’s ready to make some money this week? Where are my $QQQ bulls at? 🐂🚀", "authorName": "Prilon Musk", "authorUsername": "prilonm", "authorAvatar": "https://pbs.twimg.com/profile_images/1845272972099190784/LXst1n5V_normal.jpg", "authorFollowers": 7051, "authorVerified": true, "likeCount": 79, "retweetCount": 3, "replyCount": 4, "quoteCount": 0, "viewCount": 4177, "bookmarkCount": 0, "createdAt": "2026-09-15T21:46:55+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/prilonm/status/2099978292770275777"}, {"id": "2099967076005769534", "text": "If you look at this chart and decide it is bearish I have ZERO idea what to tell you... \n\nIt is pretty obvious what is happening here with $SPY https://t.co/GAtVXKIFPX", "authorName": "Gabe Anderson Trades 🔮", "authorUsername": "GAndersonTrades", "authorAvatar": "https://pbs.twimg.com/profile_images/2086138903854022656/5WCWtX--_normal.jpg", "authorFollowers": 13270, "authorVerified": true, "likeCount": 57, "retweetCount": 4, "replyCount": 15, "quoteCount": 1, "viewCount": 6696, "bookmarkCount": 5, "createdAt": "2026-09-15T21:02:21+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/GAndersonTrades/status/2099967076005769534"}, {"id": "2099960928661889227", "text": "🚨 If for any reason, Fed raise rates and market go up 1-2% tomorrow, take profits and run 🚀🏃🏻\nCome back after mid term elections. \n\n$SPY $QQQ", "authorName": "vnkumar trades 🏌🏽‍♂️🏇🏋🏻‍♂️🐆", "authorUsername": "vnkumarvnk", "authorAvatar": "https://pbs.twimg.com/profile_images/1784059737539026944/H7LJalhX_normal.jpg", "authorFollowers": 67590, "authorVerified": true, "likeCount": 156, "retweetCount": 4, "replyCount": 11, "quoteCount": 1, "viewCount": 15467, "bookmarkCount": 16, "createdAt": "2026-09-15T20:37:55+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/vnkumarvnk/status/2099960928661889227"}, {"id": "2099959133499957480", "text": "$SPX Just from the technicals, it doesn't look all that great. \n\nBut we'll see what happens tomorrow! https://t.co/3Yug4b4GSa", "authorName": "Heisenberg", "authorUsername": "Mr_Derivatives", "authorAvatar": "https://pbs.twimg.com/profile_images/1648535580870078465/OtGyTOWY_normal.jpg", "authorFollowers": 621006, "authorVerified": true, "likeCount": 224, "retweetCount": 12, "replyCount": 39, "quoteCount": 0, "viewCount": 34211, "bookmarkCount": 29, "createdAt": "2026-09-15T20:30:47+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/Mr_Derivatives/status/2099959133499957480"}, {"id": "2099956901429518438", "text": "$SPY Aged well. Tomorrow is the big day.\n\nHave a good evening ✌️", "authorName": "Bassem", "authorUsername": "Basssem666", "authorAvatar": "https://pbs.twimg.com/profile_images/1949490579307429888/WT0-uEtl_normal.jpg", "authorFollowers": 22690, "authorVerified": true, "likeCount": 52, "retweetCount": 2, "replyCount": 9, "quoteCount": 0, "viewCount": 7257, "bookmarkCount": 0, "createdAt": "2026-09-15T20:21:55+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/Basssem666/status/2099956901429518438"}, {"id": "2099956019883581876", "text": "$SPY $QQQ\n\nFOMC 🤮 \n\nMarkets hate uncertainty \n\nWhatever happens we will at least know, and that’s certainty \n\nWe have priced in high oil, high interest rates, and high fear\n\nWe have sold the rumor, so now… do we buy the news? https://t.co/YfGuihuHMx", "authorName": "Banana3", "authorUsername": "Banana3Stocks", "authorAvatar": "https://pbs.twimg.com/profile_images/2038006299062140928/-2eCnEvw_normal.jpg", "authorFollowers": 153844, "authorVerified": true, "likeCount": 156, "retweetCount": 6, "replyCount": 24, "quoteCount": 0, "viewCount": 15194, "bookmarkCount": 8, "createdAt": "2026-09-15T20:18:25+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/Banana3Stocks/status/2099956019883581876"}, {"id": "2099955445267890412", "text": "The last time the Fed started a rate hike cycle was 2022.\nThe Nasdaq $QQQ lost 33% in 2022\nThe Russell 2000 $IWM lost 21% in 2022\nThe S&amp;P 500 lost 19% in 2022.", "authorName": "Will Meade", "authorUsername": "thechartdr", "authorAvatar": "https://pbs.twimg.com/profile_images/1917230797020401664/WlELcRzo_normal.jpg", "authorFollowers": 273853, "authorVerified": true, "likeCount": 147, "retweetCount": 18, "replyCount": 0, "quoteCount": 4, "viewCount": 25704, "bookmarkCount": 18, "createdAt": "2026-09-15T20:16:08+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/thechartdr/status/2099955445267890412"}, {"id": "2099955393791467614", "text": "$QQQ 4 hour divergence. https://t.co/Huh0PardyF", "authorName": "The Rock Trading Group", "authorUsername": "The_Roc