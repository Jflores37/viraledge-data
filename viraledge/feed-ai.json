[{"id": "2111565812989349965", "text": "NOW: An air raid alert has been issued in Riyadh and Khamis Mushait according to local sources.\n\nAdditionally, Saudi Civil Defense published air raid alerts as well.\n\nContributed by: @BeamTracker_ https://t.co/dcnWdhFB5W", "authorName": "Open Source Intel", "authorUsername": "Osint613", "authorAvatar": "https://pbs.twimg.com/profile_images/2094762039746936832/f8vexHZ2_normal.jpg", "authorFollowers": 1780758, "authorVerified": true, "likeCount": 120, "retweetCount": 28, "replyCount": 5, "quoteCount": 2, "viewCount": 23974, "bookmarkCount": 7, "createdAt": "2026-10-17T21:11:35+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/Osint613/status/2111565812989349965"}, {"id": "2111564382266429930", "text": "Fortunately, if you made it in before the drawbridge went up, you may be looking at permanent lifetime employment. https://t.co/Wt2IbmUOVs", "authorName": "Andrew Curran", "authorUsername": "AndrewCurran_", "authorAvatar": "https://pbs.twimg.com/profile_images/1596945208058744833/_X3LT7fb_normal.jpg", "authorFollowers": 108863, "authorVerified": true, "likeCount": 217, "retweetCount": 5, "replyCount": 24, "quoteCount": 4, "viewCount": 7634, "bookmarkCount": 45, "createdAt": "2026-10-17T21:05:54+00:00", "hashtags": [], "isRetweet": false, "url": "https://x.com/AndrewCurran_/status/2111564382266429930"}, {"id": "2111563956666110287", "text": "We’ve been working with OpenCode on yesterday’s breach and have revoked Claude API keys we believe were affected.\n\nIf you saved a key in OpenCode and want to be extra careful, please create a new one!", "authorName": "Lydia Hallie ✨", "authorUsername": "lydiahallie", "authorAvatar": "https://pbs.twimg.com/profile_images/1994238936345137154/exEBW2UI_normal.jpg", "authorFollowers": 138318, "authorVerified": true, "likeCount": 196, "retweetCount": 6, "replyCount": 17, "quoteCount": 5, "viewCount": 5841, "bookmarkCount": 12, "createdAt": "2026-10-17T21:04:12+00:00", "hashtags"